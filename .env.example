# Copy to .env.local for local development. On GitHub use: Settings > Secrets and variables > Actions > Variables.
# Firebase values default to the BANA project (bana-a5770); only set them to override.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# Firebase plan (keep spark unless you moved to Blaze)
VITE_FIREBASE_PLAN_MODE=spark
VITE_ENABLE_CLOUD_FUNCTIONS=false

# Render backend + media broker (same values as the user site)
VITE_BACKEND_URL=
VITE_MEDIA_BROKER_URL=

# Public URL of the BANA USER site (adds the "User site" and "Open Profile" links). No trailing slash.
VITE_USER_SITE_URL=

# Auto sign-out after this many idle minutes (default 30)
VITE_ADMIN_IDLE_MINUTES=30
